# Copy to .env and fill in. Never commit .env.
#
# This one file holds every key and setting the project reads. Each layer reads it from the repository
# root, whatever directory a command runs in. A real environment variable wins over a line here.

# --- The Python service (src/leagueasymode/config.py) ---
# Every setting is listed with the default the code uses; tests/test_env_example.py fails when
# the two drift apart. Leave a secret's value empty.

# development | staging | production
LEAGUEASYMODE_ENVIRONMENT=development
LEAGUEASYMODE_LOG_LEVEL=INFO
# How often the game's API is asked during a game, in seconds.
LEAGUEASYMODE_POLL_INTERVAL_SECONDS=0.5
# The game's API. A replay (leagueasymode replay) serves plain HTTP on another port.
LEAGUEASYMODE_GAME_API_BASE_URL=https://127.0.0.1:2999
# Where recordings are kept. Empty: ~/Library/Application Support/LeagueasyMode/recordings on a Mac.
LEAGUEASYMODE_RECORDINGS_DIRECTORY=
# The League client's lockfile, when League is not installed in /Applications.
LEAGUEASYMODE_LEAGUE_CLIENT_LOCKFILE=
# A stand-in for the League client, such as a replay's address (http://127.0.0.1:2998); empty to
# find the running client.
LEAGUEASYMODE_LEAGUE_CLIENT_BASE_URL=
# The overlay's local web server; 0 picks a free port, which leagueasymode run prints.
LEAGUEASYMODE_OVERLAY_PORT=0
# Whether leagueasymode run also records every game it shows.
LEAGUEASYMODE_RECORD_WHILE_RUNNING=True
# The pause after each question to the League client about a player (two per player per game, one
# at a time), to stay gentle on the client and on Riot.
LEAGUEASYMODE_PLAYER_LOOKUP_PAUSE_SECONDS=0.25
# Whether the engine may fetch each patch's champion and item stats from Riot's Data Dragon, once a
# patch: the one request it makes beyond this machine. False: only patches already on disk are used.
LEAGUEASYMODE_DOWNLOAD_PATCH_STATS=True
# Data Dragon's address, or a stand-in's.
LEAGUEASYMODE_DATA_DRAGON_BASE_URL=https://ddragon.leagueoflegends.com
# Where each patch's Data Dragon files are kept. Empty: ~/Library/Application Support/LeagueasyMode/
# patch-data on a Mac.
LEAGUEASYMODE_PATCH_DATA_DIRECTORY=
# The model provider's API key, for anything that calls the real model (a paid eval run, the service
# itself). The gate and the tests never need it.
LEAGUEASYMODE_MODEL_API_KEY=
