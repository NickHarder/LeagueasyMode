<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LeagueasyMode.app's Info.plist. scripts/build_app.sh puts the version from pyproject.toml in. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>LeagueasyMode</string>
	<key>CFBundleExecutable</key>
	<string>LeagueasyOverlay</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.nickharder.leagueasymode</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>LeagueasyMode</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD_NUMBER@</string>
	<!-- The commit the app was built from, which the menu names beside the build (BuildInfo). -->
	<key>LeagueasyModeCommit</key>
	<string>@COMMIT@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!-- A menu bar app: no Dock icon, as main.swift's activation policy also says. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- The overlay page comes from the engine on 127.0.0.1 over plain HTTP; let the web view load
	     it whatever App Transport Security makes of a local address. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
