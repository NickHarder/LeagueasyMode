{
  "$defs": {
    "CasePlayer": {
      "additionalProperties": false,
      "description": "One of the ten players, for the target chips.",
      "properties": {
        "participant_id": {
          "title": "Participant Id",
          "type": "integer"
        },
        "champion": {
          "title": "Champion",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "string"
        },
        "side": {
          "enum": [
            "ally",
            "enemy"
          ],
          "title": "Side",
          "type": "string"
        },
        "is_defendant": {
          "title": "Is Defendant",
          "type": "boolean"
        },
        "is_friend": {
          "title": "Is Friend",
          "type": "boolean"
        }
      },
      "required": [
        "participant_id",
        "champion",
        "position",
        "side",
        "is_defendant",
        "is_friend"
      ],
      "title": "CasePlayer",
      "type": "object"
    },
    "ViewExhibit": {
      "additionalProperties": false,
      "description": "One exhibit, and where its value came from.",
      "properties": {
        "letter": {
          "title": "Letter",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "game",
            "timeline",
            "live",
            "computation"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "supporting": {
          "title": "Supporting",
          "type": "boolean"
        }
      },
      "required": [
        "letter",
        "label",
        "display",
        "unit",
        "source",
        "source_kind",
        "supporting"
      ],
      "title": "ViewExhibit",
      "type": "object"
    },
    "ViewLane": {
      "additionalProperties": false,
