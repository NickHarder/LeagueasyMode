  "required": [
    "game_id",
    "players",
    "target",
    "spice",
    "spice_name",
    "prove",
    "take",
    "verdict_title",
    "verdict_summary",
    "acquitted",
    "board",
    "lines",
    "closing_line",
    "closing_line_limit",
    "risk_warning",
    "exhibits"
  ],
  "title": "CaseView",
  "type": "object"
}
