{
  "$defs": {
    "BackEstimate": {
      "additionalProperties": false,
      "description": "A player's last trip to base: when they shopped, and when they are back where they play.\n\nInferred (`inference/backs.py`): buying needs the fountain, so a purchase made alive is a trip\nto base; the way back is an estimate, the walk from the fountain at their move speed.",
      "properties": {
        "shopped_at_game_time_seconds": {
          "title": "Shopped At Game Time Seconds",
          "type": "number"
        },
        "returns_at_game_time_seconds": {
          "title": "Returns At Game Time Seconds",
          "type": "number"
        }
      },
      "required": [
        "shopped_at_game_time_seconds",
        "returns_at_game_time_seconds"
      ],
      "title": "BackEstimate",
      "type": "object"
    },
    "BuffTimer": {
      "additionalProperties": false,
      "description": "A team's Baron or Elder buff, and when it runs out.",
      "properties": {
        "buff": {
          "enum": [
            "baron",
            "elder"
          ],
          "title": "Buff",
          "type": "string"
        },
        "holder": {
          "enum": [
            "ally",
            "enemy"
          ],
          "title": "Holder",
          "type": "string"
        },
        "ends_at_game_time_seconds": {
          "title": "Ends At Game Time Seconds",
          "type": "number"
        }
      },
      "required": [
        "buff",
        "holder",
        "ends_at_game_time_seconds"
      ],
      "title": "BuffTimer",
      "type": "object"
    },
    "Callout": {
      "additionalProperties": false,
      "description": "A short notice shown for a few seconds when something happens.\n\nMost state a fact; a suggestion names an action.",
