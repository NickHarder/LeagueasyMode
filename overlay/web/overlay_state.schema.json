      "type": "string"
    },
    "CampTimer": {
      "additionalProperties": false,
      "description": "A jungle camp a jungler likely cleared, and when it is back.\n\nAn estimate (`inference/jungle_path.py`): which camps were cleared, and when, comes from the\njungler's likely path.",
