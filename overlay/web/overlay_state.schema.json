{
  "$defs": {
    "BuffTimer": {
      "additionalProperties": false,
      "description": "A team's Baron or Elder buff, and when it runs out.",
      "properties": {
        "buff": {
          "enum": [
            "baron",
            "elder"
          ],
          "title": "Buff",
          "type": "string"
        },
        "holder": {
          "enum": [
            "ally",
            "enemy"
          ],
          "title": "Holder",
          "type": "string"
        },
        "ends_at_game_time_seconds": {
          "title": "Ends At Game Time Seconds",
          "type": "number"
        }
      },
      "required": [
        "buff",
        "holder",
        "ends_at_game_time_seconds"
      ],
      "title": "BuffTimer",
      "type": "object"
    },
    "Callout": {
      "additionalProperties": false,
      "description": "A short notice shown for a few seconds when something happens; never an instruction.",
      "properties": {
        "callout_id": {
          "title": "Callout Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CalloutKind"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "shown_until_game_time_seconds": {
          "title": "Shown Until Game Time Seconds",
          "type": "number"
        }
      },
      "required": [
        "callout_id",
        "kind",
        "text",
        "shown_until_game_time_seconds"
      ],
      "title": "Callout",
      "type": "object"
    },
    "CalloutKind": {
      "enum": [
        "numbers_window",
        "level_spike",
        "objective_soon",
        "item_spike"
      ],
      "type": "string"
    },
    "DragonTimer": {
      "additionalProperties": false,
      "description": "The next dragon or Elder Dragon: when it spawns, and the race for the soul.\n\nEvery value restates the kill feed and the map; nothing here is estimated.",
      "properties": {
        "objective": {
          "enum": [
            "dragon",
            "elder_dragon"
          ],
          "title": "Objective",
          "type": "string"
        },
        "status": {
          "enum": [
            "not_spawned",
            "respawning",
            "alive"
          ],
          "title": "Status",
          "type": "string"
        },
        "spawns_at_game_time_seconds": {
          "title": "Spawns At Game Time Seconds",
          "type": "number"
        },
        "ally_dragon_count": {
          "title": "Ally Dragon Count",
          "type": "integer"
        },
        "enemy_dragon_count": {
          "title": "Enemy Dragon Count",
          "type": "integer"
        },
        "soul_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Soul Type"
        },
        "soul_holder": {
          "anyOf": [
            {
              "enum": [
                "ally",
                "enemy"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Soul Holder"
        }
      },
      "required": [
        "objective",
        "status",
        "spawns_at_game_time_seconds",
        "ally_dragon_count",
        "enemy_dragon_count",
        "soul_type",
        "soul_holder"
      ],
      "title": "DragonTimer",
      "type": "object"
    },
    "InhibitorTimer": {
      "additionalProperties": false,
      "description": "A destroyed inhibitor, and when it comes back.",
      "properties": {
        "side": {
          "enum": [
            "ally",
            "enemy"
          ],
          "title": "Side",
          "type": "string"
        },
        "lane": {
          "enum": [
            "top",
            "mid",
            "bot"
          ],
          "title": "Lane",
          "type": "string"
        },
        "respawns_at_game_time_seconds": {
          "title": "Respawns At Game Time Seconds",
          "type": "number"
        }
      },
      "required": [
        "side",
        "lane",
        "respawns_at_game_time_seconds"
      ],
      "title": "InhibitorTimer",
      "type": "object"
    },
    "NumbersWindow": {
      "additionalProperties": false,
      "description": "More of the enemy team is dead than of the player's, until the respawn that evens it.",
      "properties": {
        "ally_dead_count": {
          "title": "Ally Dead Count",
          "type": "integer"
        },
        "enemy_dead_count": {
          "title": "Enemy Dead Count",
          "type": "integer"
        },
        "ends_at_game_time_seconds": {
          "title": "Ends At Game Time Seconds",
          "type": "number"
        }
      },
      "required": [
        "ally_dead_count",
        "enemy_dead_count",
        "ends_at_game_time_seconds"
      ],
      "title": "NumbersWindow",
      "type": "object"
    },
    "ObjectiveTimer": {
      "additionalProperties": false,
      "description": "The next spawn of an epic monster other than the dragons.\n\n`is_rule_verified` is false while its spawn rule is not yet confirmed for this season, so the\nwidget can mark the timer as provisional.",
      "properties": {
        "objective": {
          "enum": [
            "baron",
            "rift_herald",
            "voidgrubs"
          ],
          "title": "Objective",
          "type": "string"
        },
        "status": {
          "enum": [
            "not_spawned",
            "respawning",
            "alive",
            "gone"
          ],
          "title": "Status",
          "type": "string"
        },
        "spawns_at_game_time_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Spawns At Game Time Seconds"
        },
        "is_rule_verified": {
          "title": "Is Rule Verified",
          "type": "boolean"
        }
      },
      "required": [
        "objective",
        "status",
        "spawns_at_game_time_seconds",
        "is_rule_verified"
      ],
      "title": "ObjectiveTimer",
      "type": "object"
    },
    "PlayerCard": {
      "additionalProperties": false,
      "description": "One player as the scoreboard shows them: side, role, level, and when they are back.",
      "properties": {
        "champion_name": {
          "title": "Champion Name",
          "type": "string"
        },
        "side": {
          "enum": [
            "ally",
            "enemy"
          ],
          "title": "Side",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "integer"
        },
        "is_dead": {
          "title": "Is Dead",
          "type": "boolean"
        },
        "respawns_at_game_time_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Respawns At Game Time Seconds"
        },
        "item_gold": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Gold"
        },
        "finished_item_names": {
          "items": {
            "type": "string"
          },
          "title": "Finished Item Names",
          "type": "array"
        }
      },
      "required": [
        "champion_name",
        "side",
        "position",
        "level",
        "is_dead",
        "respawns_at_game_time_seconds"
      ],
      "title": "PlayerCard",
      "type": "object"
    },
    "TeamItemGold": {
      "additionalProperties": false,
      "description": "What each team's items are worth: gold earned and spent, not gold in hand.",
      "properties": {
        "ally_item_gold": {
          "title": "Ally Item Gold",
          "type": "integer"
        },
        "enemy_item_gold": {
          "title": "Enemy Item Gold",
          "type": "integer"
        }
      },
      "required": [
        "ally_item_gold",
        "enemy_item_gold"
      ],
      "title": "TeamItemGold",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything the overlay shows at one moment.",
  "properties": {
    "is_game_running": {
      "title": "Is Game Running",
      "type": "boolean"
    },
    "game_time_seconds": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Game Time Seconds"
    },
    "dragon": {
      "anyOf": [
        {
          "$ref": "#/$defs/DragonTimer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "objectives": {
      "items": {
        "$ref": "#/$defs/ObjectiveTimer"
      },
      "title": "Objectives",
      "type": "array"
    },
    "buffs": {
      "items": {
        "$ref": "#/$defs/BuffTimer"
      },
      "title": "Buffs",
      "type": "array"
    },
    "inhibitors": {
      "items": {
        "$ref": "#/$defs/InhibitorTimer"
      },
      "title": "Inhibitors",
      "type": "array"
    },
    "players": {
      "items": {
        "$ref": "#/$defs/PlayerCard"
      },
      "title": "Players",
      "type": "array"
    },
    "numbers_window": {
      "anyOf": [
        {
          "$ref": "#/$defs/NumbersWindow"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "team_item_gold": {
      "anyOf": [
        {
          "$ref": "#/$defs/TeamItemGold"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "callouts": {
      "items": {
        "$ref": "#/$defs/Callout"
      },
      "title": "Callouts",
      "type": "array"
    }
  },
  "required": [
    "is_game_running"
  ],
  "title": "OverlayState",
  "type": "object"
}
